# File dan folder yang TIDAK perlu di-upload ke GitHub/cloud
# ============================================================

# Dependencies (diinstall ulang otomatis oleh cloud)
node_modules/

# File database lokal (di cloud pakai Neon PostgreSQL)
webhook.db.json

# File ngrok (tidak perlu di cloud)
ngrok.exe

# Konfigurasi rahasia (jangan pernah upload ke GitHub!)
.env

# Logs
*.log
npm-debug.log*
